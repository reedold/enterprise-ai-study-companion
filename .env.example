# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Groq ---
GROQ_API_KEY=gsk_your_groq_api_key
# Must be a chat model your Groq key can access (check with client.models.list()).
# Llama 3.x models are not available on all keys; openai/gpt-oss-120b is the strong default.
# Use openai/gpt-oss-20b for faster / cheaper responses.
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional tuning ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=75
MAX_UPLOAD_MB=25
RAG_TOP_K=8
RAG_MATCH_THRESHOLD=0.30
# OCR for scanned PDFs (EasyOCR). Languages: comma-separated codes, e.g. en,az or en,ru
OCR_ENABLED=true
OCR_LANGUAGES=en
OCR_DPI=200
OCR_MAX_PAGES=50
# Comma-separated list, or * for any origin
CORS_ORIGINS=*
